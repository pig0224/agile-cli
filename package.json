{
  "name": "fcc-agile-cli",
  "version": "2.6.0",
  "description": "Agile workspace CLI — one root, five drawers. Single-repo workspace: external resources (company specs, team knowledge base, project templates, Claude Code plugins) pulled by one sync command, with worktree management and project scaffolding from a git template registry. AI agents use the CLI directly via Bash. (一个根、五个抽屉的 Workspace 生命周期管理 CLI)",
  "type": "module",
  "bin": {
    "agile": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "cli",
    "workspace",
    "git",
    "worktree",
    "monorepo",
    "claude",
    "scaffold"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pig0224/agile-cli.git"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepare": "husky",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "picocolors": "^1.1.0",
    "yaml": "^2.7.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
