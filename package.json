{
  "name": "fcc-agile-cli",
  "version": "1.0.0",
  "description": "Agile workspace CLI — one root, five drawers. Single-repo workspace with registry-driven external submodule sync, worktree management, health checks, project scaffolding from a git template registry, Claude Code plugin install from a git marketplace, and a built-in MCP server for AI agents. (一个根、五个抽屉的 Workspace 生命周期管理 CLI)",
  "type": "module",
  "bin": {
    "agile": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "cli",
    "workspace",
    "git",
    "submodule",
    "worktree",
    "monorepo",
    "mcp",
    "model-context-protocol",
    "claude",
    "scaffold"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pig0224/agile-cli.git"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "picocolors": "^1.1.0",
    "yaml": "^2.7.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
